{
  "kind": "collectionType",
  "collectionName": "items",
  "info": {
    "singularName": "item",
    "pluralName": "items",
    "displayName": "Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "price": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "duration": {
      "type": "integer",
      "required": true,
      "default": 1
    },
    "capacity": {
      "type": "integer",
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true,
      "required": false
    },
    "schedule": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::schedule.schedule",
      "inversedBy": "items"
    },
    "reservation": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::reservation.reservation",
      "inversedBy": "items"
    }
  }
}
